<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_verif_kz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bleu_nuit_kz"
    android:orientation="horizontal"
    android:padding="12dp"
    android:weightSum="1">

    <!-- el image 3al isar: poids 0.3 -->
    <ImageView
        android:id="@+id/img_passeport_kz"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:contentDescription="@string/titre_billet"
        android:scaleType="centerInside"
        android:src="@drawable/ic_passeport_kz" />

    <!-- el RelativeLayout 3al imin: poids 0.7 -->
    <RelativeLayout
        android:id="@+id/rel_textes_kz"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="@drawable/bg_billet_kz"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_titre_billet_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:text="@string/titre_billet"
            android:textColor="@color/brun_kz"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_nom_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_titre_billet_kz"
            android:layout_marginTop="20dp"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_age_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_kz"
            android:layout_marginTop="12dp"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_trajet_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_kz"
            android:layout_marginTop="12dp"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_motif_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_trajet_kz"
            android:layout_marginTop="12dp"
            android:textColor="@color/black"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/tv_alerte_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_motif_kz"
            android:layout_marginTop="16dp"
            android:text="@string/alerte_paradoxe"
            android:textColor="@color/rouge_kz"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_refuser_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/btn_refuser" />

        <Button
            android:id="@+id/btn_approuver_kz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_refuser_kz"
            android:text="@string/btn_approuver" />
    </RelativeLayout>
</LinearLayout>